---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, summary, year, language, stack, tags, repo, repos, demo, docs, links } =
  project.data;
const { Content } = await render(project);
---

<Base title={title} description={summary} ogType="article">
  <article class="project">
    <p class="back"><a href="/">← All projects</a></p>
    <header>
      <p class="kicker"><span>{language}</span> · {year}</p>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
      <div class="actions">
        <a class="button" href={repo} rel="noopener">
          <Icon name="github" size={18} /> Source code
        </a>
        {
          demo && (
            <a class="button secondary" href={demo} rel="noopener">
              <Icon name="external" size={18} /> Live demo
            </a>
          )
        }
        {
          docs && (
            <a class="button secondary" href={docs} rel="noopener">
              <Icon name="external" size={18} /> API docs
            </a>
          )
        }
        {
          links.map((link) => (
            <a class="button secondary" href={link.url} rel="noopener">
              <Icon name={link.url.includes('docker.com') ? 'docker' : 'external'} size={18} />{' '}
              {link.label}
            </a>
          ))
        }
      </div>
    </header>

    <div class="layout">
      <div class="prose body">
        <Content />
      </div>

      <aside aria-label="Project details">
        {
          stack.length > 0 && (
            <section>
              <h2>Stack</h2>
              <ul class="stack">
                {stack.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </section>
          )
        }
        {
          repos.length > 0 && (
            <section>
              <h2>Repositories</h2>
              <ul class="repo-list">
                {repos.map((r) => (
                  <li>
                    <a href={r.url} rel="noopener">
                      {r.label}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
        {
          tags.length > 0 && (
            <section>
              <h2 class="visually-hidden">Tags</h2>
              <ul class="tags">
                {tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            </section>
          )
        }
      </aside>
    </div>
  </article>
</Base>

<style>
  .back {
    margin: 0 0 1.5rem;
    font-size: 0.95rem;
  }

  .kicker {
    margin: 0 0 0.4rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .kicker span {
    font-family: var(--mono);
    font-weight: 600;
    color: var(--accent);
  }

  .summary {
    font-size: 1.15rem;
    color: var(--muted);
    max-width: 44rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.25rem 0 0.5rem;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }

  @media (min-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 16rem;
      gap: 3rem;
    }

    aside {
      position: sticky;
      top: 1.5rem;
      align-self: start;
      margin-top: 2.5rem;
    }
  }

  aside section {
    margin-bottom: 1.5rem;
  }

  aside h2 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin: 0 0 0.6rem;
  }

  .stack,
  .repo-list {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.95rem;
  }

  .stack li,
  .repo-list li {
    margin: 0;
    padding: 0.3rem 0;
    border-bottom: 1px solid var(--border);
  }

  .repo-list a {
    display: inline-block;
    padding: 0.2rem 0;
    font-family: var(--mono);
    font-size: 0.85rem;
  }

  .body :global(h2) {
    padding-top: 0.25rem;
  }

  /* Architecture diagrams, pre-rendered to SVG by rehype-mermaid. */
  .body :global(picture) {
    display: block;
    margin: 0 0 1.25rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    overflow-x: auto;
  }

  .body :global(picture img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
  }

  /* On phones, keep wide diagrams legible and let them scroll sideways inside the frame. */
  @media (max-width: 640px) {
    .body :global(picture img) {
      /* Keep diagrams at a readable size instead of shrinking them to the screen width. */
      max-width: 46rem;
    }
  }
</style>
