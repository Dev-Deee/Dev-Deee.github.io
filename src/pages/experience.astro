---
import Base from '../layouts/Base.astro';

// Sources: Dayo's resume and LinkedIn profile.
const entries = [
  {
    role: 'Software Engineering Trainee',
    org: 'Semicolon Africa, Lagos',
    type: 'Training programme · Completed',
    dates: 'Sep 2025 – Sep 2026',
    points: [
      'Built backend systems in Java (Spring Boot), Python (Django REST Framework), Go (Gin) and JavaScript (Node.js, Express), including REST APIs backed by PostgreSQL and MongoDB.',
      'Led a team of peers to deliver a visitor management system to MVP within a three-week sprint.',
      'Integrated Paystack payments into a Spring Boot service, with webhook-driven payment confirmation and signature verification, and deployed it on AWS EC2.',
      'Took part in peer code reviews and gave technical presentations to the cohort, including one on Spring Security.',
    ],
  },
  {
    role: 'Audio Production Lead',
    org: 'ShowGear Limited · Dunamis International Gospel Centre, Abuja',
    type: '',
    dates: 'May 2023 – Aug 2025',
    points: [
      'Ran the sound department at the Glory Dome, a 100,000+ capacity venue, leading a team of up to 15 people.',
      'Oversaw deployment and maintenance of the audio, video and lighting systems, integrating live sound with broadcast streaming and in-venue AV.',
      'Managed live broadcast audio for online audiences across multiple streaming platforms.',
      'Trained interns, volunteers and client teams on system operation and troubleshooting.',
    ],
  },
  {
    role: 'Audio Engineer',
    org: 'ALTRASAV Limited, Abuja',
    type: 'Contract',
    dates: 'Jun 2025 – Jul 2025',
    points: [
      'Led installation and integration of digital sound systems for the House of Assembly and the Court of Appeal, Abuja.',
      'Implemented Dante audio networking across multiple sources and devices, and supervised the engineering team from planning to handover.',
    ],
  },
  {
    role: 'Audio-Visual Engineer',
    org: 'ProAV Sistems',
    type: 'Freelance',
    dates: 'Jan 2018 – present',
    points: [
      'Designed and deployed AV systems for live events, corporate installations and studios across Lagos.',
      'Delivered installations for high-profile clients, including the Federal House of Representatives, handling site surveys and technical sign-off with senior stakeholders.',
    ],
  },
  {
    role: 'Mixing & Mastering Engineer and Studio Manager',
    org: 'Sophia Studios',
    type: '',
    dates: 'Jan 2019 – Dec 2022',
    points: [
      'Ran day-to-day studio operations: scheduling, client relations and technical readiness for every session.',
      'Recorded, mixed and mastered music projects, and trained interns on studio workflow.',
    ],
  },
  {
    role: 'Project Manager, Audio Post-Production',
    org: 'JBI Studios & Andovar',
    type: '',
    dates: '2020 – 2021',
    points: [
      'Managed voice-over localisation projects for international clients and ran quality control on deliverables against strict deadlines.',
    ],
  },
];
---

<Base
  title="Experience"
  description="Software engineering training at Semicolon Africa and seven years leading live audio-visual systems engineering."
>
  <div class="prose">
    <h1>Experience</h1>
    <p class="muted">
      My software engineering training, plus the audio-visual systems engineering career
      (2016–2025) and team leadership that came before it.
    </p>

    <ol class="timeline">
      {
        entries.map((e) => (
          <li>
            <h2>{e.role}</h2>
            <p class="org">
              <strong>{e.org}</strong>
              {e.type && <span> · {e.type}</span>}
            </p>
            <p class="dates muted">{e.dates}</p>
            <ul>
              {e.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>

    <h2 class="skills-heading">What carries over</h2>
    <ul>
      <li><strong>Running systems that can't fail.</strong> I plan for redundancy, monitor closely and stay calm when something breaks.</li>
      <li><strong>Leading people.</strong> I've briefed, delegated to and coordinated teams of up to 15 on tight schedules.</li>
      <li><strong>Managing projects.</strong> I've taken work from a client brief through design and delivery to sign-off.</li>
      <li><strong>Systems thinking.</strong> Signal flow and service architecture are both about how components connect and fail.</li>
    </ul>
  </div>
</Base>

<style>
  .timeline {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    border-left: 2px solid var(--border);
  }

  .timeline > li {
    position: relative;
    margin: 0 0 2.25rem;
    padding-left: 1.5rem;
  }

  .timeline > li::before {
    content: '';
    position: absolute;
    left: -7px;
    top: 0.45rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
    border: 2px solid var(--bg);
  }

  .timeline h2 {
    margin: 0 0 0.2rem;
    font-size: 1.2rem;
  }

  .org {
    margin: 0;
  }

  .dates {
    margin: 0 0 0.6rem;
    font-size: 0.9rem;
    font-family: var(--mono);
  }

  .skills-heading {
    margin-top: 1rem;
  }
</style>
